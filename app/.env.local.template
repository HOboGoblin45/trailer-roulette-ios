# Copy this file to `.env.local` and fill in the values.
# Vite reads variables prefixed with VITE_ at build time.

VITE_TMDB_API_KEY=your-tmdb-v3-api-key-here

# After deploying landing-page/ to Vercel or GitHub Pages, paste the live
# privacy.html URL here. Used by AboutScreen's "Privacy policy" link.
# Example: https://trailer-roulette-landing.vercel.app/privacy
VITE_PRIVACY_POLICY_URL=

VITE_TMDB_BEARER_TOKEN=your-tmdb-v4-bearer-token-here

